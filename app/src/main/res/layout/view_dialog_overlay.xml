<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0A0E1A"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#EE141A2E"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dialogNpcName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFE0A73C"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogSpeech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:textColor="#FFF5F1E6"
            android:textAppearance="?attr/textAppearanceBody1" />

        <ProgressBar
            android:id="@+id/dialogSpinner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dialogOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/dialog_leave"
            android:textColor="#B0F5F1E6" />

    </LinearLayout>

</FrameLayout>
