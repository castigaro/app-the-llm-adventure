<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/craftRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD0A0E1A"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Scrollbar, damit Ergebnistexte die Buttons nicht aus dem Bild schieben;
         clickable, damit Tipps im Panel nicht das Overlay schließen. -->
    <ScrollView
        android:id="@+id/craftPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:fillViewport="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#EE141A2E"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/craft_title"
            android:textColor="#FFE0A73C"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <!-- Werkbank: 3 Eingabe-Slots → Pfeil → Ergebnis -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.castigaro.thellmadventure.ui.IconView
                android:id="@+id/craftSlot0"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#33FFFFFF" />

            <com.castigaro.thellmadventure.ui.IconView
                android:id="@+id/craftSlot1"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:background="#33FFFFFF" />

            <com.castigaro.thellmadventure.ui.IconView
                android:id="@+id/craftSlot2"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:background="#33FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="→"
                android:textColor="#FFF5F1E6"
                android:textSize="28sp" />

            <com.castigaro.thellmadventure.ui.IconView
                android:id="@+id/craftResult"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#33E0A73C" />

        </LinearLayout>

        <!-- Ausgeschriebene Namen der eingelegten Gegenstände („Handspiegel + Feuerstein + …") -->
        <TextView
            android:id="@+id/craftSlotNames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textColor="#FFF5F1E6"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/craftHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="@string/craft_hint"
            android:textColor="#B0F5F1E6"
            android:textAppearance="?attr/textAppearanceCaption" />

        <!-- Ergebnis-/Fehlertext der letzten Kombination (z. B. „unmöglich") -->
        <TextView
            android:id="@+id/craftFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textColor="#FFE0A73C"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/craftInventory"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/craftCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="#B0F5F1E6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/craftCombine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="@string/craft_combine" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

</FrameLayout>
